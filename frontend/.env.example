# StudyMate AI — frontend configuration
#
# Copy this file to `frontend/.env` and adjust the values.
#   cp frontend/.env.example frontend/.env
#
# Only variables prefixed with VITE_ are exposed to the browser.
# Never put a secret in this file — VITE_* values are public.

# Base URL of the FastAPI backend, including the version prefix.
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Target used by the Vite dev proxy in `vite.config.ts`.
# Only needed if you change the port the backend runs on.
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
