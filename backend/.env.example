# StudyMate AI — backend configuration
#
# Copy this file to `backend/.env` and adjust the values.
# From the repository root: cp backend/.env.example backend/.env
# From backend/:           cp .env.example .env
#
# `.env` is git-ignored. Never commit real secrets.

# --- Application -------------------------------------------------------
ENVIRONMENT=development
DEBUG=true

# --- Server ------------------------------------------------------------
HOST=127.0.0.1
PORT=8000

# --- CORS --------------------------------------------------------------
# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# --- Database ----------------------------------------------------------
# Defaults to a SQLite file inside backend/storage/.
# DATABASE_URL=sqlite:///./storage/studymate.db

# --- Uploads -----------------------------------------------------------
MAX_UPLOAD_SIZE_MB=25

# --- LLM (Ollama) ------------------------------------------------------
# Ollama runs locally: https://ollama.com/download
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=llama3.1:8b
OLLAMA_TIMEOUT_SECONDS=600
# Retrieval embeddings use EMBEDDING_MODEL below, not an Ollama embedding model.

# --- Retrieval ---------------------------------------------------------
# Embeddings run locally with Sentence Transformers (install the `rag` extra).
# The first question downloads EMBEDDING_MODEL from Hugging Face (~90 MB).
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=5
# Chunks below this cosine similarity are treated as irrelevant. When nothing
# clears the threshold the API refuses to answer instead of guessing.
RETRIEVAL_MIN_SCORE=0.2
RETRIEVAL_MAX_DOCUMENTS=10

# --- Answer generation ------------------------------------------------
ANSWER_TEMPERATURE=0.1
ANSWER_MAX_TOKENS=512
ANSWER_TOP_P=0.9

# --- Index storage -----------------------------------------------------
# Rebuildable FAISS index files (one pair per document).
# INDEX_DIR=./storage/indexes

# --- API keys ----------------------------------------------------------
# Not required for local Ollama. Add a key here only if you swap in a
# hosted provider, and keep the value in your shell or a secret manager.
# OPENAI_API_KEY=
