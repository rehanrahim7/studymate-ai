# StudyMate AI — backend configuration
#
# Copy this file to `backend/.env` and adjust the values.
#   cp backend/.env.example backend/.env
#
# `.env` is git-ignored. Never commit real secrets.

# --- Application -------------------------------------------------------
ENVIRONMENT=development
DEBUG=true

# --- Server ------------------------------------------------------------
HOST=127.0.0.1
PORT=8000

# --- CORS --------------------------------------------------------------
# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database ----------------------------------------------------------
# Defaults to a SQLite file inside backend/storage/.
# DATABASE_URL=sqlite:///./storage/studymate.db

# --- Uploads -----------------------------------------------------------
MAX_UPLOAD_SIZE_MB=25

# --- LLM (Ollama) ------------------------------------------------------
# Ollama runs locally: https://ollama.com/download
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TIMEOUT_SECONDS=120

# --- Retrieval ---------------------------------------------------------
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=5

# --- API keys ----------------------------------------------------------
# Not required for local Ollama. Add a key here only if you swap in a
# hosted provider, and keep the value in your shell or a secret manager.
# OPENAI_API_KEY=
